{
  "name": "prospect-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build --webpack && node scripts/check-built-styles.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --import tsx --test --test-concurrency=4 src/lib/*.test.ts src/lib/contracts/*.test.ts",
    "agentos:smoke": "node --import tsx scripts/agentos-smoke.ts",
    "agentos:actor-check": "node --import tsx scripts/agentos-actor-test.ts",
    "pi:readiness": "node --import tsx scripts/pi-durable-readiness.mts",
    "verify": "npm run test:unit && npm run test:convex && npm run lint && npm run typecheck",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:convex": "vitest run",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "graph": "npm --prefix graph run graph --",
    "lifecycle": "npm --prefix lifecycle run lifecycle --",
    "agent:loop": "node scripts/agent-auto-loop.mjs",
    "test:contracts": "node --import tsx --test --test-concurrency=4 src/lib/contracts/*.test.ts",
    "test:storage": "node --import tsx --test --test-concurrency=4 src/lib/storage/*.test.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:components": "node --import tsx --test --test-concurrency=4 src/lib/components/*.test.ts && node scripts/prove-component-screenshots.mjs",
    "test:sprites": "node --import tsx --test --test-concurrency=4 src/lib/sprites/*.test.ts",
    "test:discovery": "node --import tsx --test --test-concurrency=4 src/lib/discovery/*.test.ts && node scripts/prove-discovery-extract.mjs",
    "test:enrichment": "node --import tsx --test --test-concurrency=4 src/lib/enrichment/*.test.ts && node scripts/prove-enrichment.mjs",
    "test:visuals": "node --import tsx --test --test-concurrency=4 src/lib/visuals/*.test.ts && node scripts/prove-visuals.mjs",
    "test:design": "node --import tsx --test --test-concurrency=4 src/lib/design/*.test.ts && node scripts/prove-design-ir.mjs",
    "test:qa": "node --import tsx --test --test-concurrency=4 src/lib/siteqa/*.test.ts && node scripts/prove-build-qa.mjs",
    "test:approvals": "node --import tsx --test --test-concurrency=4 src/lib/handoff/*.test.ts src/lib/contracts/*.test.ts && node scripts/prove-handoff.mjs"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/agent": "^0.7.9",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/better-auth": "^0.12.6",
    "@convex-dev/geospatial": "^0.2.1",
    "@convex-dev/mcp": "0.1.0-alpha.7",
    "@convex-dev/r2": "0.10.4",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/workflow": "0.4.10",
    "@convex-dev/workpool": "^0.4.15",
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@earendil-works/pi-telemetry": "^1.4.0",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@fly/sprites": "^0.2.4",
    "@google/stitch-sdk": "^0.3.5",
    "@rivet-dev/agentos-core": "^0.4.7",
    "@rivet-dev/pi": "^0.5.4",
    "@rivet-dev/sandbox-adapter": "^0.5.4",
    "@rivetkit/next-js": "^2.3.31",
    "@types/leaflet": "^1.9.22",
    "@vercel/sandbox": "^3.9.1",
    "agentmail": "^0.5.50",
    "better-auth": "~1.6.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "convex": "^1.49.0",
    "convex-secret-store": "^0.2.0",
    "duckdb": "^1.3.2",
    "firecrawl": "^4.51.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rivetkit": "^2.3.31",
    "sandbox-agent": "^0.5.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@google/stitch": "^0.12.1",
    "@rivetkit/cli": "^2.3.31",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "storybook": "^8.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5",
    "vite": "^5.4.19",
    "vitest": "^4.1.12"
  },
  "packageManager": "npm@11.6.2",
  "allowScripts": {
    "duckdb@1.3.2": true
  }
}
