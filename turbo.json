{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test:unit": {
      "tags": [
        "ci"
      ],
      "outputs": []
    },
    "lint": {
      "tags": [
        "ci"
      ],
      "outputs": []
    },
    "typecheck": {
      "tags": [
        "ci"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "test:unit",
        "lint",
        "typecheck"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  }
}
